# Copy to .env and adjust. All values shown are the defaults.

# --- paths -------------------------------------------------------------
# Override directory for the YAML rule files. Files missing from your copy
# fall back to the packaged defaults in backend/config.
# IFCSCHED_CONFIG_DIR=./backend/config

# Uploads, per-project element stores and the SQLite database.
# IFCSCHED_DATA_DIR=./data
# IFCSCHED_DATABASE_URL=sqlite:///./data/ifcsched.db

# --- limits ------------------------------------------------------------
# IFCSCHED_MAX_UPLOAD_MB=1024
# Cap on how many elements fall back to ifcopenshell.geom for quantities.
# IFCSCHED_MAX_DERIVED_GEOMETRY=20000

# --- api ---------------------------------------------------------------
# IFCSCHED_CORS_ORIGINS=http://localhost:5173

# --- optional LLM layer (off by default) --------------------------------
# The core pipeline is fully deterministic and does not need any of this.
# IFCSCHED_LLM_ENABLED=false
# IFCSCHED_LLM_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=

# --- frontend ----------------------------------------------------------
# Where `npm run dev` proxies /api to.
# VITE_API_TARGET=http://localhost:8000
