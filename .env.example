# Copy to `.env`, fill in after registering an OAuth app in Speckle.
# See README "Register an OAuth app in Speckle".
SPECKLE_APP_ID=
SPECKLE_APP_SECRET=

# Anthropic API key for the AI mapping + animation generation features.
# Without this, the M2 "ai_map_columns" job will fail.
ANTHROPIC_API_KEY=

# Optional: override the default Claude model (claude-sonnet-4-6).
# CLAUDE_MODEL=claude-sonnet-4-6
